# Core telemetry
TELEMETRY_ENABLED=1
TELEMETRY_SERVER_NAME=voc-amazon-reviews
TELEMETRY_HASH_SALT=replace-with-random-secret
TELEMETRY_LOG_PATH=./logs/telemetry.jsonl

# Redis sink (recommended)
REDIS_URL=redis://localhost:6379/0

# Optional client override per deployment
# MCP_CLIENT=claude_code

# Optional OpenTelemetry sink (parallel to Redis/JSONL)
OTEL_ENABLED=1
OTEL_SERVICE_NAME=voc-amazon-reviews-mcp
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
